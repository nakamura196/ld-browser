---
// Old address /browse/?u=… : the top page now takes ?u= itself, so send visitors there.
import Base from "../layouts/Base.astro";
import { dict, root, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const d = dict[lang];
const home = root(lang);
---
<Base lang={lang} title={d.titles.browse} current="browse">
  <script is:inline define:vars={{ home }}>location.replace(home + location.search + location.hash);</script>
  <p><a href={home}>LD Browser</a></p>
</Base>
