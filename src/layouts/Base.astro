---
// Shared frame for every page: header (brand + navigation, optional slot for a form) and footer.
interface Props {
  title?: string;
  description?: string;
  current?: "home" | "browse" | "about";
}
const { title, description = "URI を入れると、その Linked Data をブラウザだけで取りに行き、表とグラフにしてたどれます。", current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const fullTitle = title ? `${title} — LD Browser` : "LD Browser";
const nav = [
  ["home", "", "ホーム"],
  ["browse", "browse/", "ブラウザ"],
  ["about", "about/", "このツールについて"],
] as const;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<link rel="icon" href={`${base}app/icon.svg`} type="image/svg+xml">
<link rel="stylesheet" href={`${base}app/style.css`}>
</head>
<body>
<header class="site">
  <div class="bar">
    <a class="brand" href={base}>
      <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
        <line x1="8" y1="10" x2="22" y2="7" /><line x1="8" y1="10" x2="16" y2="24" /><line x1="22" y1="7" x2="16" y2="24" />
        <circle cx="8" cy="10" r="4" /><circle cx="22" cy="7" r="3.2" /><circle cx="16" cy="24" r="4.4" />
      </svg>
      LD Browser
    </a>
    <nav aria-label="サイト">
      {nav.map(([key, path, text]) => (
        <a href={base + path} aria-current={current === key ? "page" : undefined}>{text}</a>
      ))}
    </nav>
  </div>
  <slot name="header" />
</header>
<main id="main" class={current === "home" ? "home" : undefined}>
  <slot />
</main>
<footer class="site">
  <p>サーバを持たず、ブラウザが直接 RDF を取りに行きます。読めるのは、別サイトからの読み込み（CORS）を許可している相手だけです。</p>
  <p>着想は神崎正英さんの <a href="https://web.archive.org/web/20250401124432/http://www.kanzaki.com/works/2014/pub/ld-browser">LD Browser</a>（2014）によります。別に作ったもので、神崎さんの道具ではありません。</p>
  <p>作成: 中村 覚 ・ <a href="https://nakamura196.github.io/railclass/">RailClass</a></p>
</footer>
</body>
</html>
